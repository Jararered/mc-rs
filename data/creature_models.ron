// Beta 1.7.3 creature models, one `ModelRenderer` box per line, in the order
// the model draws them. Lengths are model pixels: +Y points down, the head
// faces -Z, and the feet rest at y = 24. `tex` is the box's corner on the
// 64x32 skin, `from` and `size` are `addBox`, `pivot` is the rotation point
// and `rotation` the angles in radians (1.5707964 is a quarter turn). A part
// with no `role` keeps its pose, and one with no `layer` is in the base pass.
{
    // `ModelPig`: `ModelQuadruped(6)`, and again half a pixel larger for the saddle.
    Pig: [
        (tex: (0, 0), from: (-4, -4, -8), size: (8, 8, 8), pivot: (0, 12, -6), role: Head()),
        (tex: (28, 8), from: (-5, -10, -7), size: (10, 16, 8), pivot: (0, 11, 2), rotation: (1.5707964, 0, 0)),
        (tex: (0, 16), from: (-2, 0, -2), size: (4, 6, 4), pivot: (-3, 18, 7), role: Leg(phase: 0)),
        (tex: (0, 16), from: (-2, 0, -2), size: (4, 6, 4), pivot: (3, 18, 7), role: Leg(phase: 3.1415927)),
        (tex: (0, 16), from: (-2, 0, -2), size: (4, 6, 4), pivot: (-3, 18, -5), role: Leg(phase: 3.1415927)),
        (tex: (0, 16), from: (-2, 0, -2), size: (4, 6, 4), pivot: (3, 18, -5), role: Leg(phase: 0)),
        (tex: (0, 0), from: (-4, -4, -8), size: (8, 8, 8), inflate: 0.5, pivot: (0, 12, -6), role: Head(), layer: Saddle),
        (tex: (28, 8), from: (-5, -10, -7), size: (10, 16, 8), inflate: 0.5, pivot: (0, 11, 2), rotation: (1.5707964, 0, 0), layer: Saddle),
        (tex: (0, 16), from: (-2, 0, -2), size: (4, 6, 4), inflate: 0.5, pivot: (-3, 18, 7), role: Leg(phase: 0), layer: Saddle),
        (tex: (0, 16), from: (-2, 0, -2), size: (4, 6, 4), inflate: 0.5, pivot: (3, 18, 7), role: Leg(phase: 3.1415927), layer: Saddle),
        (tex: (0, 16), from: (-2, 0, -2), size: (4, 6, 4), inflate: 0.5, pivot: (-3, 18, -5), role: Leg(phase: 3.1415927), layer: Saddle),
        (tex: (0, 16), from: (-2, 0, -2), size: (4, 6, 4), inflate: 0.5, pivot: (3, 18, -5), role: Leg(phase: 0), layer: Saddle),
    ],
