#![enable(implicit_some)]
// Beta 1.7.3's `Item` registry: one row per standalone item, in id order
// (256 up, then the two records). A block's own item is not listed; it stacks
// to 64 and takes its subtypes from the block. What a row leaves out is the
// plain item: a stack of 64 with no damage value.
//
//   stack       `maxStackSize`
//   durability  `maxDamage`: uses before the item breaks
//   subtypes    the highest damage value that names a variety (coal, dye)
//   map         the damage value is a map's number
//   places      the block the item puts down when used
//   heal        `ItemFood.healAmount`, in half hearts
//   armor       the slot the piece is worn in and `damageReduceAmount`
//   tool        the kind and `EnumToolMaterial`: Pick, Axe, Shovel, Sword or
//               Hoe of Wood, Stone, Iron, Diamond or Gold, or Shears
//   leaves      `containerItem`: what crafting with it hands back
{
    IronShovel: (stack: 1, durability: 250, tool: Shovel(Iron)),
    IronPickaxe: (stack: 1, durability: 250, tool: Pick(Iron)),
    IronAxe: (stack: 1, durability: 250, tool: Axe(Iron)),
    FlintAndSteel: (stack: 1, durability: 64),
    Apple: (stack: 1, heal: 4),
    Bow: (stack: 1),
    Arrow: (),
    Coal: (subtypes: 1),
    Diamond: (),
    IronIngot: (),
    GoldIngot: (),
    IronSword: (stack: 1, durability: 250, tool: Sword(Iron)),
    WoodenSword: (stack: 1, durability: 59, tool: Sword(Wood)),
