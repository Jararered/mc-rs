// Beta 1.7.3's furnace. An item is written as in `recipes.ron`: "Name", or
// "Name:data" for one subtype or damage value; "block.Name" is a block's own
// item where an item shares its name.
(
    // `FurnaceRecipes`: what an input smelts into, and how many.
    smelting: {
        "IronOre": ("IronIngot", 1),
        "GoldOre": ("GoldIngot", 1),
        "DiamondOre": ("Diamond", 1),
        "Sand": ("Glass", 1),
        "Cobblestone": ("Stone", 1),
        "Cactus": ("Dye:2", 1),
        "Wood": ("Coal:1", 1),
        "RawPorkchop": ("CookedPorkchop", 1),
        "RawFish": ("CookedFish", 1),
        "ClayBall": ("Brick", 1),
    },
    // `TileEntityFurnace.getItemBurnTime`, in ticks. Smelting one item takes
    // 200. Every block of `Material.wood` burns for 300.
    fuel: {
        "Coal": 1600,
        "Stick": 100,
        "LavaBucket": 20000,
        "Sapling": 100,
        "Wood": 300,
        "WoodenPlanks": 300,
        "Chest": 300,
        "CraftingTable": 300,
        "Bookshelf": 300,
        "WoodenStairs": 300,
        "block.WoodenDoor": 300,
        "Fence": 300,
        "Trapdoor": 300,
        "WoodenPressurePlate": 300,
        "NoteBlock": 300,
        "Jukebox": 300,
        "LockedChest": 300,
        "StandingSign": 300,
        "WallSign": 300,
    },
)
