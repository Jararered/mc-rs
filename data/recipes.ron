// The Beta 1.7.3 recipe book, in the order `CraftingManager` registers it;
// the first recipe that matches a grid wins. An item is written "Name", or
// "Name:data" for one subtype (as an ingredient) or damage value (as an
// output). `out` is the item and how many.
[
    Shaped(rows: ["###", " X ", " X "], key: {'#': "WoodenPlanks", 'X': "Stick"}, out: ("WoodenPickaxe", 1)),
    Shaped(rows: ["#", "X", "X"], key: {'#': "WoodenPlanks", 'X': "Stick"}, out: ("WoodenShovel", 1)),
